                   <p>
    @footerAddress<br>
    <strong>Hotline:</strong> @footerPhone<br>
    <strong>Email:</strong> @footerEmail<br>

    <strong>TP. Hồ Chí Minh:</strong> Lô A9-12, Đường số 11, KCN Lê Minh Xuân 3, Huyện Bình Chánh<br>
   <strong>Đồng Nai:</strong> Lô 35, Đường số 14, KCN Giang Điền, Huyện Trảng Bom<br>
   <strong>Long An:</strong> Lô D21, Đường số 9, KCN Phú An Thạnh, Huyện Bến Lức<br>
    <strong>Bình Dương:</strong> Lô F12-CN, Đường D4, KCN Bàu Bàng, Huyện Bàu Bàng<br>
    <button type="button"
            onclick="toggleBranches()"
            style="margin-top:8px;padding:4px 10px;border:none;border-radius:6px;cursor:pointer;">
        Xem thêm cơ sở
    </button>

    <div id="branchList" style="display:none; margin-top:10px;">
       
       
        <strong>Bà Rịa - Vũng Tàu:</strong> Lô SZ7, Đường D5, KCN Sonadezi Châu Đức, Huyện Châu Đức<br>
        <strong>Cà Mau:</strong> Lô CN18, Đường số 7, KCN Sông Đốc, Huyện Trần Văn Thời<br>
        <strong>Bạc Liêu:</strong> Lô C11, Đường N4, KCN Láng Trâm, Thị xã Giá Rai<br>
        <strong>Kiên Giang:</strong> Lô D6, Đường số 8, KCN Thuận Yên, TP. Hà Tiên<br>
        <strong>Sóc Trăng:</strong> Lô E14, Đường D6, KCN Trần Đề, Huyện Trần Đề<br>
        <strong>Hậu Giang:</strong> Lô CN-09, Đường số 11, KCN Hậu (GĐ 1), Huyện Châu Thành<br>
        <strong>Trà Vinh:</strong> Lô F13, Đường số 6, KCN Cầu Quan, Huyện Tiểu Cần<br>
    </div>

    <br>
    <strong>Website đang chờ đăng ký với BCT</strong>
</p>

<script>
    function toggleBranches() {
        const branchList = document.getElementById('branchList');

        if (branchList.style.display === 'none') {
            branchList.style.display = 'block';
        } else {
            branchList.style.display = 'none';
        }
    }
</script>
                        <div class="social-links d-flex mt-3">
                            <a href="@facebookLink"
                               class="d-flex align-items-center justify-content-center"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="Facebook">
                                <i class="bi bi-facebook"></i>
                            </a>

                            <a href="@zaloLink"
                               class="d-flex align-items-center justify-content-center"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="Zalo">
                                <i class="bi bi-instagram"></i>
                            </a>

                            <a href="@zaloLink"
                               class="d-flex align-items-center justify-content-center"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="Youtube">
                                <i class="bi bi-youtube"></i>
                            </a>

                            <a href="@footerPhoneHref"
                               class="d-flex align-items-center justify-content-center"
                               aria-label="Gọi hotline @footerPhone">
                                <i class="bi bi-telephone"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Liên kết nhanh</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                        <li><a asp-controller="Blog" asp-action="Index" asp-route-categoryName="dich-vu" rel="nofollow">Dịch vụ</a></li>
                        <li><a asp-controller="Product" asp-action="Index">Mặt hàng</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Mặt hàng</h4>
                    <ul>
                        @foreach (var product in featuredProducts)
                        {
                            <li>
                                <a href="@BuildProductUrl(product.Slug, product.Id)">
                                    @product.Name
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Dịch vụ</h4>
                    <ul>
                        <li>
                            <a asp-controller="Blog" asp-action="Index" asp-route-categoryName="dich-vu" rel="nofollow">
                                Xem tất cả dịch vụ
                            </a>
                        </li>

                        @foreach (var post in topServicePosts)
                        {
                            <li>
                                <a href="@BuildBlogUrl(post.Slug, post.Id)">
                                    @post.Title
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Khu vực phục vụ</h4>
                    <ul>
                        <li><a asp-controller="Contact" asp-action="Index">TP. Hồ Chí Minh</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Bình Dương</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Đồng Nai</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Long An</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Tây Ninh</a></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <div class="footer-legal text-center position-relative">
        <div class="container">
            <div class="copyright">
                &copy; Copyright <strong><span>Phế Liệu Thành Trung</span></strong>. All Rights Reserved
            </div>

            <div class="credits">
                Giao diện trang chủ đã được chuyển đổi sang mô hình website thu mua phế liệu.
            </div>
        </div>
    </div>
</footer>

<div class="social-button is-open">
