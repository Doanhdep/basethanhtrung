@using WebThuMuaPheLieu.helpper
@inject IContactInfoHelper ContactInfoHelper
@inject ILayoutDataHelper LayoutDataHelper

@{
    var contact = await ContactInfoHelper.GetContactInfoAsync();

    var footerPhone = !string.IsNullOrWhiteSpace(contact.Phone)
        ? contact.Phone
        : "0974640626";

    var footerPhoneDigits = new string(footerPhone.Where(char.IsDigit).ToArray());

    var footerPhoneHref = string.IsNullOrWhiteSpace(footerPhoneDigits)
        ? "tel:0974640626"
        : $"tel:{footerPhoneDigits}";

    var footerEmail = !string.IsNullOrWhiteSpace(contact.Gmail)
        ? contact.Gmail
        : "info@phelieuthanhphat.vn";

    var footerAddress = !string.IsNullOrWhiteSpace(contact.Address)
        ? contact.Address
        : "Hóc Môn, TP. Hồ Chí Minh";

    var facebookLink = string.IsNullOrWhiteSpace(contact.Facebook)
        ? "#"
        : (
            contact.Facebook.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || contact.Facebook.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                ? contact.Facebook
                : $"https://{contact.Facebook.TrimStart('/')}"
        );

    var zaloLink = string.IsNullOrWhiteSpace(contact.Zalo)
        ? "#"
        : (
            contact.Zalo.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || contact.Zalo.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
                ? contact.Zalo
                : $"https://zalo.me/{contact.Zalo.TrimStart('/').Replace("zalo.me/", string.Empty, StringComparison.OrdinalIgnoreCase)}"
        );

    var featuredProducts = await LayoutDataHelper.GetFooterFeaturedProductsAsync();

    var topServicePosts = await LayoutDataHelper.GetFooterTopServicePostsAsync();

    string BuildProductUrl(string? slug, int id)
    {
        return Url.RouteUrl("product-detail-seo", new { slug }) ?? "/";
    }

    string BuildBlogUrl(string? slug, int id)
    {
        var normalizedSlug = !string.IsNullOrWhiteSpace(slug)
            ? slug.Trim()
            : id.ToString();

        return Url.RouteUrl("blog-detail-seo", new { slug = normalizedSlug }) ?? "/Blog";
    }
}

<footer id="footer" class="footer">
