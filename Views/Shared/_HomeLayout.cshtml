@inject WebThuMuaPheLieu.helpper.ISeoSettingHelper SeoSettingHelper
@{
    var seoSettings = await SeoSettingHelper.GetSeoSettingsAsync();

    var pageTitle = ViewData["Title"]?.ToString()?.Trim();
    var pageDescription = ViewData["Description"]?.ToString()?.Trim();
    var pageKeywords = ViewData["Keywords"]?.ToString()?.Trim();
    var pageCanonical = ViewData["Canonical"]?.ToString()?.Trim();
    var pageOgType = ViewData["OgType"]?.ToString()?.Trim();
    var pageRobots = ViewData["Robots"]?.ToString()?.Trim();

    var metaTitle = seoSettings.TryGetValue("MetaTitle", out var storedMetaTitle) && !string.IsNullOrWhiteSpace(storedMetaTitle)
        ? storedMetaTitle
        : "Phế Liệu Thành Trung";

    if (!string.IsNullOrWhiteSpace(pageTitle))
    {
        metaTitle = $"{pageTitle} - Phế Liệu Thành Trung";
    }

    var metaDescription = seoSettings.TryGetValue("MetaDescription", out var storedMetaDescription) && !string.IsNullOrWhiteSpace(storedMetaDescription)
        ? storedMetaDescription
        : "Phế Liệu Thành Trung chuyên thu mua phế liệu giá cao tận nơi tại TP.HCM, Bình Dương, Đồng Nai. Nhận thu mua sắt, đồng, nhôm, inox, giấy carton, nhựa và máy móc cũ.";

    if (!string.IsNullOrWhiteSpace(pageDescription))
    {
        metaDescription = pageDescription;
    }

    var seoKeywords = seoSettings.TryGetValue("SeoKeywords", out var storedSeoKeywords) && !string.IsNullOrWhiteSpace(storedSeoKeywords)
        ? storedSeoKeywords
        : "thu mua phế liệu, phế liệu giá cao, thu mua sắt vụn, thu mua đồng, thu mua nhôm, thu mua inox";

    if (!string.IsNullOrWhiteSpace(pageKeywords))
    {
        seoKeywords = pageKeywords;
    }

    var ogTitle = seoSettings.TryGetValue("OgTitle", out var storedOgTitle) && !string.IsNullOrWhiteSpace(storedOgTitle)
        ? storedOgTitle
        : metaTitle;

    var ogImage = seoSettings.TryGetValue("OgImage", out var storedOgImage) && !string.IsNullOrWhiteSpace(storedOgImage)
        ? storedOgImage
        : "/assets/img/satthep.jpg";

    var faviconUrl = Url.Content(ogImage);
    var absoluteOgImageUrl = faviconUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
        || faviconUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            ? faviconUrl
            : $"{Context.Request.Scheme}://{Context.Request.Host}{faviconUrl}";
    var currentAbsoluteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
    var canonicalUrl = !string.IsNullOrWhiteSpace(pageCanonical)
        ? pageCanonical
        : currentAbsoluteUrl;
    var ogUrl = canonicalUrl;
    var ogType = !string.IsNullOrWhiteSpace(pageOgType) ? pageOgType : "website";
    var needsSwiper = ViewData["NeedsSwiper"] is true
        || string.Equals(ViewData["NeedsSwiper"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    var needsAos = ViewData["NeedsAos"] is true
        || string.Equals(ViewData["NeedsAos"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    var needsBungee = ViewData["NeedsBungee"] is true
        || string.Equals(ViewData["NeedsBungee"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    var needsMaterialSymbols = ViewData["NeedsMaterialSymbols"] is true
        || string.Equals(ViewData["NeedsMaterialSymbols"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var showHomePreloader = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>@metaTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="@seoKeywords" />
    @if (!string.IsNullOrWhiteSpace(pageRobots))
    {
        <meta name="robots" content="@pageRobots" />
    }
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@ogUrl" />
    <meta property="og:image" content="@absoluteOgImageUrl" />
    <meta property="og:type" content="@ogType" />

    <link href="@faviconUrl" rel="icon" />
    <link href="@faviconUrl" rel="apple-touch-icon" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload"
          as="style"
          href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Roboto:wght@500;700&family=Work+Sans:wght@600;700&display=swap"
          onload="this.onload=null;this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Roboto:wght@500;700&family=Work+Sans:wght@600;700&display=swap"
              rel="stylesheet" />
    </noscript>
    @if (needsBungee)
    {
        <link rel="preload"
              as="style"
              href="https://fonts.googleapis.com/css2?family=Bungee&display=swap"
              onload="this.onload=null;this.rel='stylesheet'" />
        <noscript>
            <link href="https://fonts.googleapis.com/css2?family=Bungee&display=swap" rel="stylesheet" />
        </noscript>
    }
    @if (needsMaterialSymbols)
    {
        <link rel="preload"
              as="style"
              href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@400..700,0..1&display=swap"
              onload="this.onload=null;this.rel='stylesheet'" />
        <noscript>
            <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@400..700,0..1&display=swap" rel="stylesheet" />
        </noscript>
    }

    @if (showHomePreloader)
    {
        <script>
            (function () {
                try {
                    if (window.sessionStorage && window.sessionStorage.getItem('homePreloaderShown') === '1') {
                        document.documentElement.classList.add('home-preloader-skipped');
                        return;
                    }
                } catch (error) {
                }

                document.documentElement.classList.add('home-preloader-enabled');
            })();
        </script>
        <style>
            html.home-preloader-enabled #page-preloader.page-preloader {
                position: fixed;
                inset: 0;
                z-index: 2147483000;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 249, 232, 0.96));
                opacity: 1;
                visibility: visible;
                pointer-events: auto;
            }

            html.home-preloader-skipped #page-preloader.page-preloader,
            html:not(.home-preloader-enabled) #page-preloader.page-preloader {
                display: none !important;
            }

            html.home-preloader-enabled #page-preloader.page-preloader.page-preloader--hidden {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }

            html.home-preloader-enabled #page-preloader .page-preloader__mark {
                width: 58px;
                height: 58px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: rgba(22, 101, 52, 0.08);
            }

            html.home-preloader-enabled #page-preloader .page-preloader__spinner {
                width: 38px;
                height: 38px;
                display: block;
                flex: 0 0 auto;
                border-radius: 50%;
                background: conic-gradient(from 0deg, rgba(22, 101, 52, 0.08) 0deg, rgba(22, 101, 52, 0.18) 120deg, #22c55e 250deg, #166534 360deg);
                -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
                mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
                transform: translateZ(0) rotate(0deg);
                transform-origin: 50% 50%;
                backface-visibility: hidden;
                will-change: transform;
                animation: pagePreloaderSpin 0.9s linear infinite;
            }

            @@keyframes pagePreloaderSpin {
                0% {
                    transform: translateZ(0) rotate(0deg);
                }

                100% {
                    transform: translateZ(0) rotate(360deg);
                }
            }
        </style>
    }

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" asp-append-version="true" />
    @if (needsAos)
    {
        <link href="~/assets/vendor/aos/aos.css" rel="stylesheet" asp-append-version="true" />
    }
    @if (needsSwiper)
    {
        <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" asp-append-version="true" />
    }

    <link href="~/assets/css/main.css" rel="stylesheet" asp-append-version="true" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-91F6NYYHMW"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-91F6NYYHMW');
    </script>

    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(ViewData["BodyClass"] as string)">
    @if (showHomePreloader)
    {
        <div id="page-preloader" class="page-preloader" aria-hidden="true">
            <div class="page-preloader__mark">
                <span class="page-preloader__spinner"></span>
            </div>
        </div>
    }

    <partial name="P_Header" />

    @RenderBody()

    <a href="#" class="scroll-top d-flex align-items-center justify-content-center active"><i class="bi bi-arrow-up-short"></i></a>

        <partial name="P_Footer" />

        @if (needsAos)
        {
            <script defer src="~/assets/vendor/aos/aos.js" asp-append-version="true"></script>
        }
        @if (needsSwiper)
        {
            <script defer src="~/assets/vendor/swiper/swiper-bundle.min.js" asp-append-version="true"></script>
        }
        @if (showHomePreloader)
        {
            <script>
                (function () {
                    var preloader = document.getElementById('page-preloader');
                    if (!preloader) {
                        return;
                    }

                    var storageKey = 'homePreloaderShown';
                    var alreadyShown = document.documentElement.classList.contains('home-preloader-skipped');
                    try {
                        if (window.sessionStorage) {
                            alreadyShown = alreadyShown || window.sessionStorage.getItem(storageKey) === '1';
                            if (!alreadyShown) {
                                window.sessionStorage.setItem(storageKey, '1');
                            }
                        }
                    } catch (error) {
                    }

                    if (alreadyShown) {
                        preloader.remove();
                        return;
                    }

                    var hidden = false;
                    var minSpinMs = 900;
                    var maxPreloaderMs = 1000;
                    var removeDelayMs = 320;
                    var elapsedMs = window.performance && typeof window.performance.now === 'function'
                        ? window.performance.now()
                        : 0;
                    var stylesReady = false;
                    var fontsReady = false;
                    var domReady = document.readyState === 'complete' || document.readyState === 'interactive';

                    var hidePreloader = function () {
                        if (hidden) {
                            return;
                        }

                        hidden = true;
                        window.clearTimeout(maxTimer);
                        preloader.classList.add('page-preloader--hidden');
                        document.documentElement.classList.remove('home-preloader-enabled');
                        document.documentElement.classList.add('home-preloader-done');
                        window.setTimeout(function () {
                            preloader.remove();
                        }, removeDelayMs);
                    };

                    var tryHideWhenReady = function () {
                        if (!domReady || !stylesReady || !fontsReady) {
                            return;
                        }

                        var remainingSpinMs = Math.max(0, minSpinMs - elapsedMs);
                        window.setTimeout(function () {
                            if (typeof window.requestAnimationFrame === 'function') {
                                window.requestAnimationFrame(function () {
                                    window.requestAnimationFrame(hidePreloader);
                                });
                                return;
                            }

                            hidePreloader();
                        }, remainingSpinMs);
                    };

                    var markReady = function (type) {
                        if (type === 'dom') {
                            domReady = true;
                        } else if (type === 'styles') {
                            stylesReady = true;
                        } else if (type === 'fonts') {
                            fontsReady = true;
                        }

                        tryHideWhenReady();
                    };

                    var waitForStyles = function () {
                        var links = Array.prototype.slice.call(document.querySelectorAll('link[rel="stylesheet"]'));
                        var pendingLinks = links.filter(function (link) {
                            return !link.sheet;
                        });

                        if (pendingLinks.length === 0) {
                            markReady('styles');
                            return;
                        }

                        var remaining = pendingLinks.length;
                        var done = function () {
                            remaining -= 1;
                            if (remaining <= 0) {
                                markReady('styles');
                            }
                        };

                        pendingLinks.forEach(function (link) {
                            link.addEventListener('load', done, { once: true });
                            link.addEventListener('error', done, { once: true });
                        });
                    };

                    var waitForFonts = function () {
                        if (document.fonts && document.fonts.ready) {
                            document.fonts.ready.then(function () {
                                markReady('fonts');
                            }).catch(function () {
                                markReady('fonts');
                            });
                            return;
                        }

                        markReady('fonts');
                    };

                    var maxTimer = window.setTimeout(hidePreloader, Math.max(0, maxPreloaderMs - elapsedMs));

                    if (domReady) {
                        markReady('dom');
                    } else {
                        document.addEventListener('DOMContentLoaded', function () {
                            markReady('dom');
                        }, { once: true });
                    }

                    waitForStyles();
                    waitForFonts();

                    window.addEventListener('pageshow', function (event) {
                        if (event.persisted) {
                            hidePreloader();
                        }
                    }, { once: true });
                })();
            </script>
        }
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var supportButton = document.querySelector('.user-support');
                var socialButton = document.querySelector('.social-button');

                if (!supportButton || !socialButton) {
                    return;
                }

                supportButton.addEventListener('click', function (event) {
                    event.preventDefault();
                    socialButton.classList.toggle('is-open');
                });
            });
        </script>
        <script>
            // Ảnh lỗi (404/đường dẫn sai) thay bằng ảnh mặc định; capture phase để bắt cả ảnh lazy-load.
            document.addEventListener('error', function (event) {
                var img = event.target;
                if (img && img.tagName === 'IMG' && !img.dataset.imageFallback) {
                    img.dataset.imageFallback = 'true';
                    img.src = '/assets/img/blog/blog-1.jpg';
                }
            }, true);
        </script>
        <script defer src="~/assets/js/main.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
